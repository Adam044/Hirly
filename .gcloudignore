# Only exclude what we don't need for deployment
node_modules/
.git/
.env
*.log
.vscode/
.vercel/
Hirly.db
.dockerignore
.gitignore
readme.md
README.md

# Exclude local uploads and large assets
public/styling/uploads/
public/images/

!public/images/flags/

# Testing and monitoring files (development only)
test-optimization.js
monitor-egress.js
optimization-test-results.json
egress-report-*.json
README-TESTING.md
TESTING-RESULTS.md

# Keep everything else including:
# - public/ (all static assets, JS, CSS, images)
# - views/ (all HTML templates)  
# - utils/ (server utilities including monitoring.js)
# - server.js (main application)
# - package.json and package-lock.json
